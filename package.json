{
  "name": "alex-portfolio-starter",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "predev": "node scripts/copy-pdf-worker.mjs",
    "dev": "next dev",
    "clean": "node -e \"for (const d of ['.next','.next-dev']) require('fs').rmSync(d, { recursive: true, force: true })\"",
    "dev:clean": "node -e \"for (const d of ['.next-dev']) require('fs').rmSync(d, { recursive: true, force: true })\" && next dev",
    "prebuild": "node scripts/copy-pdf-worker.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "next lint"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@floating-ui/dom": "^1.8.0",
    "@fontsource/satoshi": "file:packages/fontsource-satoshi",
    "@tailwindcss/typography": "^0.5.20",
    "@tiptap/extension-highlight": "^3.32.0",
    "@tiptap/extension-list": "^3.32.0",
    "@tiptap/extensions": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@tiptap/suggestion": "^3.32.0",
    "@vercel/blob": "^2.8.2",
    "@xyflow/react": "^12.12.0",
    "fflate": "^0.8.3",
    "html-to-image": "^1.11.13",
    "lucide-react": "0.446.0",
    "next": "^15.5.24",
    "pdf-parse": "^2.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@types/node": "20.14.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "10.4.20",
    "postcss": "8.5.32",
    "tailwindcss": "3.4.10",
    "typescript": "5.6.2"
  },
  "overrides": {
    "postcss": "$postcss",
    "zod": "^4.6.7",
    "postcss-selector-parser": "^6.1.5"
  }
}
